---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags, author = 'Your Name' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title={title} 
			description={description} 
			image={heroImage}
			article={true}
			publishedTime={pubDate.toISOString()}
			modifiedTime={updatedDate?.toISOString()}
			author={author}
		/>
	</head>

	<body>
		<Header />
		
		<main class="blog-post-main">
			<article class="blog-post" itemscope itemtype="https://schema.org/BlogPosting">
				<!-- Hero Section -->
				<header class="post-header">
					<div class="container">
						<div class="post-meta">
							<time datetime={pubDate.toISOString()} itemprop="datePublished" class="post-date">
								<FormattedDate date={pubDate} />
							</time>
							{updatedDate && (
								<time datetime={updatedDate.toISOString()} itemprop="dateModified" class="post-updated">
									Updated <FormattedDate date={updatedDate} />
								</time>
							)}
						</div>
						
						<h1 class="post-title" itemprop="headline">{title}</h1>
						
						<div class="post-info">
							<div class="author-info" itemprop="author" itemscope itemtype="https://schema.org/Person">
								<img 
									src="/images/author-avatar.jpg" 
									alt={author}
									class="author-avatar"
									width="40"
									height="40"
								/>
								<span itemprop="name">{author}</span>
							</div>
							
							{tags && tags.length > 0 && (
								<div class="post-tags">
									{tags.map((tag: string) => (
										<a href={`/blog/tags/${tag}`} class="tag" itemprop="keywords">
											#{tag}
										</a>
									))}
								</div>
							)}
						</div>
					</div>
				</header>

				<!-- Hero Image -->
				{heroImage && (
					<div class="hero-image-container">
						<img 
							src={heroImage} 
							alt={title}
							class="hero-image"
							itemprop="image"
							width="1200"
							height="600"
							loading="eager"
						/>
					</div>
				)}

				<!-- Post Content -->
				<div class="post-content">
					<div class="container">
						<div class="prose" itemprop="articleBody">
							<slot />
						</div>
					</div>
				</div>

				<!-- Post Footer -->
				<footer class="post-footer">
					<div class="container">
						<!-- Share Buttons -->
						<div class="share-section">
							<h3 class="share-title">Share this post</h3>
							<div class="share-buttons">
								<a 
									href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="share-button share-twitter"
									aria-label="Share on Twitter"
								>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
										<path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
									</svg>
									Twitter
								</a>
								
								<a 
									href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="share-button share-linkedin"
									aria-label="Share on LinkedIn"
								>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
									</svg>
									LinkedIn
								</a>
								
								<button 
									class="share-button share-copy"
									data-url={Astro.url.href}
									aria-label="Copy link"
								>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
										<path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
									</svg>
									Copy Link
								</button>
							</div>
						</div>

						<!-- Navigation -->
						<nav class="post-navigation" aria-label="Post navigation">
							<a href="/blog" class="nav-back">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
									<path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
								</svg>
								Back to Blog
							</a>
						</nav>
					</div>
				</footer>
			</article>
		</main>

		<Footer />

		<!-- Copy to clipboard functionality -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const copyButton = document.querySelector('.share-copy');
				
				if (copyButton) {
					copyButton.addEventListener('click', async () => {
						const url = copyButton.getAttribute('data-url');
						
						try {
							await navigator.clipboard.writeText(url);
							
							// Visual feedback
							const originalText = copyButton.innerHTML;
							copyButton.innerHTML = `
								<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
									<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
								</svg>
								Copied!
							`;
							
							setTimeout(() => {
								copyButton.innerHTML = originalText;
							}, 2000);
						} catch (err) {
							console.error('Failed to copy URL:', err);
						}
					});
				}
			});
		</script>
	</body>
</html>

<style>
	.blog-post-main {
		min-height: calc(100vh - var(--header-height));
	}

	.post-header {
		background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
		color: white;
		padding: var(--space-16) 0 var(--space-12);
		text-align: center;
	}

	.post-meta {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		margin-bottom: var(--space-6);
		font-size: var(--text-sm);
		opacity: 0.9;
	}

	.post-date,
	.post-updated {
		padding: var(--space-2) var(--space-4);
		background-color: rgba(255, 255, 255, 0.1);
		border-radius: var(--radius-full);
		font-weight: 500;
	}

	.post-title {
		font-size: var(--text-5xl);
		font-weight: 700;
		line-height: 1.1;
		margin-bottom: var(--space-8);
		max-width: 800px;
		margin-left: auto;
		margin-right: auto;
	}

	.post-info {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-6);
		flex-wrap: wrap;
	}

	.author-info {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		font-weight: 500;
	}

	.author-avatar {
		border-radius: var(--radius-full);
		border: 2px solid rgba(255, 255, 255, 0.2);
	}

	.post-tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.tag {
		padding: var(--space-1) var(--space-3);
		background-color: rgba(255, 255, 255, 0.1);
		color: white;
		text-decoration: none;
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 500;
		transition: var(--transition);
	}

	.tag:hover {
		background-color: rgba(255, 255, 255, 0.2);
		text-decoration: none;
		color: white;
	}

	.hero-image-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 var(--space-4);
		transform: translateY(-var(--space-16));
		margin-bottom: calc(-1 * var(--space-16));
	}

	.hero-image {
		width: 100%;
		height: auto;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-xl);
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.post-content {
		padding: var(--space-16) 0;
	}

	.prose {
		max-width: 720px;
		margin: 0 auto;
		line-height: 1.7;
	}

	.prose > * + * {
		margin-top: var(--space-6);
	}

	.prose h2 {
		margin-top: var(--space-12);
		margin-bottom: var(--space-6);
		color: var(--text-primary);
	}

	.prose h3 {
		margin-top: var(--space-10);
		margin-bottom: var(--space-4);
		color: var(--text-primary);
	}

	.prose p {
		font-size: var(--text-lg);
		color: var(--text-secondary);
	}

	.prose blockquote {
		border-left: 4px solid var(--primary);
		padding-left: var(--space-6);
		margin: var(--space-8) 0;
		font-style: italic;
		font-size: var(--text-lg);
		color: var(--text-secondary);
	}

	.prose img {
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
		margin: var(--space-8) 0;
	}

	.prose pre {
		border-radius: var(--radius-lg);
		margin: var(--space-8) 0;
		font-size: var(--text-sm);
	}

	.prose code:not(pre code) {
		background-color: var(--bg-secondary);
		color: var(--primary);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		font-size: 0.9em;
	}

	.post-footer {
		background-color: var(--bg-secondary);
		padding: var(--space-12) 0;
		border-top: 1px solid var(--border);
	}

	.share-section {
		text-align: center;
		margin-bottom: var(--space-10);
	}

	.share-title {
		font-size: var(--text-lg);
		margin-bottom: var(--space-6);
		color: var(--text-primary);
	}

	.share-buttons {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.share-button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--text-secondary);
		text-decoration: none;
		font-weight: 500;
		font-size: var(--text-sm);
		background-color: var(--bg-primary);
		transition: var(--transition);
		cursor: pointer;
	}

	.share-button:hover {
		background-color: var(--bg-secondary);
		border-color: var(--primary);
		color: var(--primary);
		text-decoration: none;
		transform: translateY(-1px);
	}

	.post-navigation {
		text-align: center;
	}

	.nav-back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-6);
		background-color: var(--primary);
		color: white;
		text-decoration: none;
		border-radius: var(--radius-md);
		font-weight: 500;
		transition: var(--transition);
	}

	.nav-back:hover {
		background-color: var(--primary-dark);
		transform: translateY(-1px);
		text-decoration: none;
		color: white;
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.post-header {
			padding: var(--space-12) 0 var(--space-8);
		}

		.post-title {
			font-size: var(--text-3xl);
		}

		.post-info {
			flex-direction: column;
			gap: var(--space-4);
		}

		.hero-image-container {
			transform: translateY(-var(--space-8));
			margin-bottom: calc(-1 * var(--space-8));
		}

		.prose {
			padding: 0 var(--space-4);
		}

		.prose p {
			font-size: var(--text-base);
		}

		.share-buttons {
			flex-direction: column;
			align-items: center;
		}

		.share-button {
			width: 200px;
			justify-content: center;
		}
	}

	@media (max-width: 480px) {
		.post-meta {
			flex-direction: column;
			gap: var(--space-2);
		}

		.post-title {
			font-size: var(--text-2xl);
		}
	}
</style>
