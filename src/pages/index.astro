---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Get recent posts
const allPosts = await getCollection('blog');
const recentPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const featuredPost = recentPosts[0];
const otherPosts = recentPosts.slice(1, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Home" 
			description={SITE_DESCRIPTION}
			keywords="blog, technology, tutorials, reviews, lifestyle"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-background">
					<div class="hero-gradient"></div>
				</div>
				<div class="container hero-content">
					<div class="hero-text animate-fade-in">
						<h1 class="hero-title">
							Welcome to <span class="hero-highlight">{SITE_TITLE}</span>
						</h1>
						<p class="hero-description">
							{SITE_DESCRIPTION}. Discover insights, tutorials, and stories that inspire and educate.
						</p>
						<div class="hero-actions">
							<a href="/blog" class="btn btn-primary btn-large">
								Explore Articles
								<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
									<path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
								</svg>
							</a>
							<a href="/about" class="btn btn-secondary btn-large">
								About Me
							</a>
						</div>
					</div>
					<div class="hero-visual animate-slide-in">
						<div class="hero-image-container">
							<img 
								src="/images/hero-illustration.svg" 
								alt="Blog illustration"
								class="hero-image"
								width="500"
								height="400"
							/>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Post Section -->
			{featuredPost && (
				<section class="featured-post">
					<div class="container">
						<div class="section-header">
							<h2 class="section-title">Featured Article</h2>
							<p class="section-description">Latest insights and stories</p>
						</div>
						
						<article class="featured-card">
							<div class="featured-image">
								<img 
									src={featuredPost.data.heroImage || '/images/post-placeholder.jpg'} 
									alt={featuredPost.data.title}
									width="600"
									height="400"
									loading="lazy"
								/>
								<div class="featured-overlay">
									<span class="featured-badge">Featured</span>
								</div>
							</div>
							<div class="featured-content">
								<div class="featured-meta">
									<time datetime={featuredPost.data.pubDate.toISOString()}>
										<FormattedDate date={featuredPost.data.pubDate} />
									</time>
									{featuredPost.data.tags && featuredPost.data.tags.length > 0 && (
										<div class="featured-tags">
											{featuredPost.data.tags.slice(0, 2).map((tag: string) => (
												<span class="tag">#{tag}</span>
											))}
										</div>
									)}
								</div>
								<h3 class="featured-title">
									<a href={`/blog/${featuredPost.id}/`}>
										{featuredPost.data.title}
									</a>
								</h3>
								<p class="featured-excerpt">
									{featuredPost.data.description}
								</p>
								<a href={`/blog/${featuredPost.id}/`} class="featured-link">
									Read Full Article
									<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
										<path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
									</svg>
								</a>
							</div>
						</article>
					</div>
				</section>
			)}

			<!-- Recent Posts Grid -->
			{otherPosts.length > 0 && (
				<section class="recent-posts">
					<div class="container">
						<div class="section-header">
							<h2 class="section-title">Recent Articles</h2>
							<a href="/blog" class="section-link">
								View All Posts
								<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
									<path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
								</svg>
							</a>
						</div>
						
						<div class="posts-grid">
							{otherPosts.map((post) => (
								<article class="post-card">
									<a href={`/blog/${post.id}/`} class="post-link">
										<div class="post-image">
											<img 
												src={post.data.heroImage || '/images/post-placeholder.jpg'} 
												alt={post.data.title}
												width="400"
												height="250"
												loading="lazy"
											/>
										</div>
										<div class="post-content">
											<div class="post-meta">
												<time datetime={post.data.pubDate.toISOString()}>
													<FormattedDate date={post.data.pubDate} />
												</time>
											</div>
											<h3 class="post-title">{post.data.title}</h3>
											<p class="post-excerpt">{post.data.description}</p>
										</div>
									</a>
								</article>
							))}
						</div>
					</div>
				</section>
			)}

			<!-- Newsletter Section -->
			<section class="newsletter">
				<div class="container">
					<div class="newsletter-content">
						<div class="newsletter-text">
							<h2 class="newsletter-title">Stay in the Loop</h2>
							<p class="newsletter-description">
								Get the latest articles and insights delivered straight to your inbox. No spam, just quality content.
							</p>
						</div>
						<form class="newsletter-form" action="/api/newsletter" method="POST">
							<div class="newsletter-input-group">
								<input 
									type="email" 
									name="email" 
									placeholder="Enter your email address" 
									required 
									aria-label="Email address"
									class="newsletter-input"
								/>
								<button type="submit" class="btn btn-primary newsletter-button">
									Subscribe
								</button>
							</div>
							<p class="newsletter-privacy">
								By subscribing, you agree to our <a href="/privacy">Privacy Policy</a>.
							</p>
						</form>
					</div>
				</div>
			</section>

			<!-- Features Section -->
			<section class="features">
				<div class="container">
					<div class="section-header">
						<h2 class="section-title">Why Read Our Blog?</h2>
						<p class="section-description">Quality content that makes a difference</p>
					</div>
					
					<div class="features-grid">
						<div class="feature-card">
							<div class="feature-icon">
								<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
									<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
								</svg>
							</div>
							<h3 class="feature-title">Quality Content</h3>
							<p class="feature-description">
								Well-researched articles that provide real value and actionable insights for our readers.
							</p>
						</div>
						
						<div class="feature-card">
							<div class="feature-icon">
								<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
									<path d="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/>
								</svg>
							</div>
							<h3 class="feature-title">Regular Updates</h3>
							<p class="feature-description">
								Fresh content published regularly to keep you informed about the latest trends and developments.
							</p>
						</div>
						
						<div class="feature-card">
							<div class="feature-icon">
								<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
									<path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zM4 18v-4h2v2h2v2H4zm0-4V6l2.5-1.25L8 5.5 10 4l2 1-1.5 1.5L12 7.5l1.5-1L16 8l2-1 1.5 2.5L22 8v8c0 1.11-.89 2-2 2H4c-1.11 0-2-.89-2-2V14h2z"/>
								</svg>
							</div>
							<h3 class="feature-title">Expert Insights</h3>
							<p class="feature-description">
								Learn from industry experts and experienced professionals sharing their knowledge and expertise.
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* Hero Section */
	.hero {
		position: relative;
		min-height: 80vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.hero-background {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 50%, var(--accent) 100%);
	}

	.hero-gradient {
		position: absolute;
		inset: 0;
		background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, transparent 50%);
	}

	.hero-content {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-16);
		align-items: center;
		z-index: 1;
	}

	.hero-text {
		color: white;
	}

	.hero-title {
		font-size: var(--text-6xl);
		font-weight: 700;
		line-height: 1.1;
		margin-bottom: var(--space-6);
	}

	.hero-highlight {
		background: linear-gradient(45deg, #fbbf24, #f59e0b);
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-description {
		font-size: var(--text-xl);
		line-height: 1.6;
		margin-bottom: var(--space-8);
		opacity: 0.9;
	}

	.hero-actions {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.btn-large {
		padding: var(--space-4) var(--space-8);
		font-size: var(--text-lg);
	}

	.hero-visual {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-image-container {
		position: relative;
		max-width: 500px;
		width: 100%;
	}

	.hero-image {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 20px 40px rgba(0,0,0,0.2));
	}

	/* Section Styles */
	.section-header {
		text-align: center;
		margin-bottom: var(--space-12);
	}

	.section-title {
		font-size: var(--text-4xl);
		font-weight: 700;
		margin-bottom: var(--space-4);
		background: linear-gradient(135deg, var(--primary), var(--accent));
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.section-description {
		font-size: var(--text-lg);
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0 auto;
	}

	.section-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--primary);
		font-weight: 500;
		text-decoration: none;
	}

	.section-link:hover {
		text-decoration: underline;
	}

	/* Featured Post */
	.featured-post {
		padding: var(--space-20) 0;
		background-color: var(--bg-secondary);
	}

	.featured-card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-12);
		background: var(--bg-primary);
		border-radius: var(--radius-2xl);
		overflow: hidden;
		box-shadow: var(--shadow-lg);
		transition: var(--transition);
	}

	.featured-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-xl);
	}

	.featured-image {
		position: relative;
		overflow: hidden;
	}

	.featured-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}

	.featured-card:hover .featured-image img {
		transform: scale(1.05);
	}

	.featured-overlay {
		position: absolute;
		top: var(--space-4);
		left: var(--space-4);
	}

	.featured-badge {
		background: linear-gradient(135deg, var(--primary), var(--accent));
		color: white;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.featured-content {
		padding: var(--space-8);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.featured-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-4);
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.featured-tags {
		display: flex;
		gap: var(--space-2);
	}

	.featured-title {
		font-size: var(--text-3xl);
		margin-bottom: var(--space-4);
	}

	.featured-title a {
		color: var(--text-primary);
		text-decoration: none;
	}

	.featured-title a:hover {
		color: var(--primary);
	}

	.featured-excerpt {
		font-size: var(--text-lg);
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: var(--space-6);
	}

	.featured-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--primary);
		font-weight: 600;
		text-decoration: none;
	}

	.featured-link:hover {
		color: var(--primary-dark);
	}

	/* Recent Posts */
	.recent-posts {
		padding: var(--space-20) 0;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		text-align: left;
		margin-bottom: var(--space-12);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--space-8);
	}

	.post-card {
		background: var(--bg-primary);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		overflow: hidden;
		transition: var(--transition);
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: var(--primary);
	}

	.post-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.post-image {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 10;
	}

	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}

	.post-card:hover .post-image img {
		transform: scale(1.05);
	}

	.post-content {
		padding: var(--space-6);
	}

	.post-meta {
		font-size: var(--text-sm);
		color: var(--text-muted);
		margin-bottom: var(--space-3);
	}

	.post-title {
		font-size: var(--text-xl);
		font-weight: 600;
		margin-bottom: var(--space-3);
		line-height: 1.3;
		color: var(--text-primary);
	}

	.post-excerpt {
		color: var(--text-secondary);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Newsletter */
	.newsletter {
		padding: var(--space-20) 0;
		background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
	}

	.newsletter-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-12);
		align-items: center;
	}

	.newsletter-text {
		color: white;
	}

	.newsletter-title {
		font-size: var(--text-4xl);
		font-weight: 700;
		margin-bottom: var(--space-4);
	}

	.newsletter-description {
		font-size: var(--text-lg);
		opacity: 0.9;
		line-height: 1.6;
	}

	.newsletter-input-group {
		display: flex;
		gap: var(--space-3);
		margin-bottom: var(--space-3);
	}

	.newsletter-input {
		flex: 1;
		padding: var(--space-4);
		border: none;
		border-radius: var(--radius-md);
		font-size: var(--text-base);
	}

	.newsletter-button {
		white-space: nowrap;
		background-color: white;
		color: var(--primary);
	}

	.newsletter-button:hover {
		background-color: var(--gray-100);
		color: var(--primary-dark);
	}

	.newsletter-privacy {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.8);
		margin: 0;
	}

	.newsletter-privacy a {
		color: white;
		text-decoration: underline;
	}

	/* Features */
	.features {
		padding: var(--space-20) 0;
		background-color: var(--bg-secondary);
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--space-8);
	}

	.feature-card {
		background: var(--bg-primary);
		padding: var(--space-8);
		border-radius: var(--radius-xl);
		text-align: center;
		border: 1px solid var(--border);
		transition: var(--transition);
	}

	.feature-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: var(--primary);
	}

	.feature-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		background: linear-gradient(135deg, var(--primary), var(--accent));
		color: white;
		border-radius: var(--radius-xl);
		margin-bottom: var(--space-6);
	}

	.feature-title {
		font-size: var(--text-xl);
		font-weight: 600;
		margin-bottom: var(--space-4);
		color: var(--text-primary);
	}

	.feature-description {
		color: var(--text-secondary);
		line-height: 1.6;
	}

	/* Responsive Design */
	@media (max-width: 1024px) {
		.hero-content {
			grid-template-columns: 1fr;
			gap: var(--space-12);
			text-align: center;
		}

		.hero-visual {
			order: -1;
		}

		.featured-card {
			grid-template-columns: 1fr;
		}

		.newsletter-content {
			grid-template-columns: 1fr;
			text-align: center;
		}
	}

	@media (max-width: 768px) {
		.hero {
			min-height: 60vh;
		}

		.hero-title {
			font-size: var(--text-4xl);
		}

		.hero-actions {
			justify-content: center;
		}

		.section-header {
			flex-direction: column;
			align-items: center;
			gap: var(--space-4);
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}

		.newsletter-input-group {
			flex-direction: column;
		}

		.newsletter-button {
			width: 100%;
		}
	}

	@media (max-width: 480px) {
		.hero-title {
			font-size: var(--text-3xl);
		}

		.section-title {
			font-size: var(--text-3xl);
		}

		.btn-large {
			width: 100%;
			justify-content: center;
		}
	}

	/* Utility Classes */
	.tag {
		display: inline-block;
		padding: var(--space-1) var(--space-3);
		background-color: var(--bg-secondary);
		color: var(--text-muted);
		font-size: var(--text-xs);
		font-weight: 500;
		border-radius: var(--radius-full);
	}
</style>
